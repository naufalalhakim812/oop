public class MataKuliah {
    private String kode;
    private String nama;
    private int sks;

    public MataKuliah(String kode, String nama, int sks) {
        this.kode = kode;
        this.nama = nama;
        this.sks = sks;
    }

    public int getSks() {
        return sks;
    }

    @Override
    public String toString() {
        return String.format("%s - %s (%d SKS)", kode, nama, sks);
    }
}
